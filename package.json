{
  "name": "planning-app",
  "version": "1.6.0",
  "desktopName": "cadence.desktop",
  "productName": "Cadence",
  "description": "Cadence: a desktop planner with browser-style tabs, lessons, deadlines, special days and habits.",
  "author": "Berkaykay",
  "main": "electron/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "dev": "node scripts/dev.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "vite build && playwright test",
    "dist": "vite build && electron-builder --publish never"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.2"
  },
  "build": {
    "appId": "com.berkaykay.planner",
    "productName": "Cadence",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Cadence-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cadence"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "syncDesktopName": true,
      "artifactName": "Cadence-${version}-linux.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Berkaykay",
        "repo": "Planning-App",
        "releaseType": "release"
      }
    ],
    "executableName": "cadence"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
